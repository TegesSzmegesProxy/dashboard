NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=tessera-control-plane
AUTH0_ISSUER_URL=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.tessera.dev
REDIS_URL=redis://localhost:6379
API_KEY_HASH_SECRET=
MACHINE_AUTH_RATE_LIMIT_PER_MINUTE=120
MACHINE_AUTH_RATE_LIMIT_FAILURE_BEHAVIOR=deny
# Ed25519 PKCS#8 PEM. Escaped "\n" line breaks are accepted. Never commit a real key.
BUNDLE_SIGNING_PRIVATE_KEY=
# AES-256-GCM key for organization integration credentials (JEV, AI model), 32
# random bytes as base64: `openssl rand -base64 32`. Without them the
# credentials cannot be saved, and JEV cannot be delivered to proxies. Never commit a real key.
CREDENTIAL_ENCRYPTION_KEY=
# Local directory for transient source snapshots and collector packages. Use a
# shared volume when running more than one instance. Contents are deleted when
# each analysis finishes.
ANALYSIS_STORAGE_DIR=./var/analysis-storage
# GitHub App (read-only Contents). Set all four or none; without them source
# repositories cannot be linked and analyses fail at source fetch.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Without a key the AI analysis step is recorded as skipped and policy
# generation attempts fail with PROVIDER_NOT_CONFIGURED.
ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5-5
ANTHROPIC_POLICY_MODEL=claude-opus-5-5
# Telemetry endpoint-window entries accepted per project and hour; batches
# beyond it get 429 and an operational alert.
TELEMETRY_QUOTA_ENTRIES_PER_TENANT_HOUR=100000
