NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=tessera-control-plane
AUTH0_ISSUER_URL=https://your-tenant.eu.auth0.com/
AUTH0_AUDIENCE=https://api.tessera.dev
REDIS_URL=redis://localhost:6379
API_KEY_HASH_SECRET=
MACHINE_AUTH_RATE_LIMIT_PER_MINUTE=120
MACHINE_AUTH_RATE_LIMIT_FAILURE_BEHAVIOR=deny
# Ed25519 PKCS#8 PEM. Escaped "\n" line breaks are accepted. Never commit a real key.
BUNDLE_SIGNING_PRIVATE_KEY=
# GitHub App (read-only Contents). Set all four or none; without them source
# repositories cannot be linked and analyses fail at source fetch.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Platform key, used only for natural-language edits of v1 policies. Analyses
# use each organization's own key (ADR-0011).
ANTHROPIC_API_KEY=
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5-5
ANTHROPIC_POLICY_MODEL=claude-opus-5-5
# Secret store for organizations' Anthropic keys (ADR-0011): vault or
# local-dev (development only, refused in production). Unset: keys cannot be
# saved and analyses stop before any model call.
SECRET_STORE=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_PATH_PREFIX=tessera
LOCAL_SECRET_STORE_FILE=./var/local-secrets.json
# 32 random bytes, base64: openssl rand -base64 32
LOCAL_SECRET_STORE_KEY=
# Repository sandbox (ADR-0009): docker (build the image with
# `docker build --target repo-host -t tessera-repo-host .`) or local-process
# (development only, no isolation, refused in production). Unset: analyses
# fail at source fetch with SANDBOX_NOT_CONFIGURED.
ANALYSIS_SANDBOX=
ANALYSIS_SANDBOX_IMAGE=tessera-repo-host:latest
ANALYSIS_SANDBOX_RUNTIME=runsc
ANALYSIS_SANDBOX_MEMORY_MB=2048
ANALYSIS_SANDBOX_TIMEOUT_MS=7200000
# Per-analysis limits; the approved budget ceiling bounds spending.
ANALYSIS_MAX_WORK_ITEMS=400
ANALYSIS_ITEM_CONCURRENCY=4
ANALYSIS_MAX_TURNS_PER_ITEM=25
ANALYSIS_ITEM_TOKEN_BUDGET=150000
# Optional JSON price overrides, USD per million tokens:
# {"claude-opus-5-5":{"input":4,"output":20,"cacheWrite":5,"cacheRead":0.2}}
AI_PRICE_TABLE=
# Environment snapshots kept per project (ADR-0012).
ENVIRONMENT_SNAPSHOTS_RETAINED=10
# Telemetry endpoint-window entries accepted per project and hour; batches
# beyond it get 429 and an operational alert.
TELEMETRY_QUOTA_ENTRIES_PER_TENANT_HOUR=100000
