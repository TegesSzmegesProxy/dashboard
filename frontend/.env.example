# Control-plane API origin (no trailing slash). Paths already include /api/v1.
VITE_API_URL=http://localhost:5000
# Auth0 SPA application. Audience must equal the backend AUTH0_AUDIENCE.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.tessera.dev
# Optional: GitHub App install URL, e.g. https://github.com/apps/<app>/installations/new
VITE_GITHUB_APP_INSTALL_URL=
