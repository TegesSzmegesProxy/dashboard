{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowUmdGlobalAccess": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@ds/*": ["./Tessera Design System/*"] }
  },
  "include": ["src"]
}
